<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="n-funzione-cambia-vettore"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="w" type="Integer" array="True" size="2"/>
            <assign variable="w[0]" expression="1"/>
            <assign variable="w[1]" expression="2"/>
            <output expression="Primo(w)" newline="True"/>
        </body>
    </function>
    <function name="Primo" type="Integer" variable="r">
        <parameters>
            <parameter name="v" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="r" type="Integer" array="False" size=""/>
            <assign variable="r" expression="v[0]"/>
            <assign variable="v[0]" expression="0"/>
        </body>
    </function>
</flowgorithm>
