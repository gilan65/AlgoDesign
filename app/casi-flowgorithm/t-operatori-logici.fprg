<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="t-operatori-logici"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="v" type="Boolean" array="False" size=""/>
            <declare name="f" type="Boolean" array="False" size=""/>
            <assign variable="v" expression="true"/>
            <assign variable="f" expression="false"/>
            <output expression="&quot;L &quot; &amp; (v &amp;&amp; f) &amp; &quot; &quot; &amp; (v ∧ v) &amp; &quot; &quot; &amp; (f || v) &amp; &quot; &quot; &amp; (f ∨ f) &amp; &quot; &quot; &amp; (!v) &amp; &quot; &quot; &amp; (¬f) &amp; &quot; &quot; &amp; (not f) &amp; &quot; &quot; &amp; (v and f or v)" newline="True"/>
        </body>
    </function>
</flowgorithm>
