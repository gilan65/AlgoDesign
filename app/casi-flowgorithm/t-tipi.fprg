    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="r" type="Real" array="False" size=""/>
            <declare name="s" type="String" array="False" size=""/>
