<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="t-per-fine-reale-indietro"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value=""/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="5" end="5 / 2" direction="dec" step="1">
                <output expression="i" newline="True"/>
            </for>
            <output expression="&quot;fine&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
