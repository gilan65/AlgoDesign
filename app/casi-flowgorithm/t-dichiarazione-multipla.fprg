<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="t-dichiarazione-multipla"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c" type="Integer" array="False" size=""/>
            <assign variable="a" expression="1"/>
            <assign variable="b" expression="2"/>
            <assign variable="c" expression="a + b"/>
            <output expression="&quot;S &quot; &amp; a &amp; &quot; &quot; &amp; b &amp; &quot; &quot; &amp; c" newline="True"/>
        </body>
    </function>
</flowgorithm>
