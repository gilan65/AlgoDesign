<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="t-potenza"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n" type="Integer" array="False" size=""/>
            <output expression="&quot;P1 &quot; &amp; 2 ^ -1" newline="True"/>
            <output expression="&quot;P2 &quot; &amp; 2 ^ 3 ^ 2" newline="True"/>
            <output expression="&quot;P3 &quot; &amp; -2 ^ 2" newline="True"/>
            <output expression="&quot;P4 &quot; &amp; 2 * 3 ^ 2" newline="True"/>
            <output expression="&quot;P5 &quot; &amp; -2 ^ 3" newline="True"/>
            <assign variable="n" expression="2 ^ 10"/>
            <output expression="&quot;P6 &quot; &amp; n" newline="True"/>
        </body>
    </function>
</flowgorithm>
