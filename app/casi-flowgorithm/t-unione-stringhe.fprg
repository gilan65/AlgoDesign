<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="t-unione-stringhe"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="s" type="String" array="False" size=""/>
            <declare name="t" type="String" array="False" size=""/>
            <declare name="u" type="String" array="False" size=""/>
            <assign variable="s" expression="&quot;ab&quot;"/>
            <assign variable="t" expression="s &amp; &quot;cd&quot; &amp; s"/>
            <output expression="t" newline="True"/>
            <assign variable="u" expression="&quot;x&quot; &amp; Char(s, 1)"/>
            <output expression="&quot;U &quot; &amp; u" newline="True"/>
        </body>
    </function>
</flowgorithm>
