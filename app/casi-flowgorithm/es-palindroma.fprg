<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="es-palindroma"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;radar &quot; &amp; Palindroma(&quot;radar&quot;)" newline="True"/>
            <output expression="&quot;ciao &quot; &amp; Palindroma(&quot;ciao&quot;)" newline="True"/>
        </body>
    </function>
    <function name="Palindroma" type="Boolean" variable="p">
        <parameters>
            <parameter name="s" type="String" array="False"/>
        </parameters>
        <body>
            <declare name="p" type="Boolean" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="p" expression="true"/>
            <for variable="i" start="0" end="Len(s) / 2 - 1" direction="inc" step="1">
                <if expression="Char(s, i) &lt;&gt; Char(s, Len(s) - 1 - i)">
                    <then>
                        <assign variable="p" expression="false"/>
                    </then>
                    <else>
                    </else>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
