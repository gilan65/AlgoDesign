<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="es-primi"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n" type="Integer" array="False" size=""/>
            <declare name="d" type="Integer" array="False" size=""/>
            <declare name="primo" type="Boolean" array="False" size=""/>
            <assign variable="n" expression="2"/>
            <while expression="n &lt;= 30">
                <assign variable="primo" expression="true"/>
                <assign variable="d" expression="2"/>
                <while expression="d * d &lt;= n and primo">
                    <if expression="n mod d = 0">
                        <then>
                            <assign variable="primo" expression="false"/>
                        </then>
                        <else>
                        </else>
                    </if>
                    <assign variable="d" expression="d + 1"/>
                </while>
                <if expression="primo">
                    <then>
                        <output expression="n &amp; &quot; &quot;" newline="False"/>
                    </then>
                    <else>
                    </else>
                </if>
                <assign variable="n" expression="n + 1"/>
            </while>
            <output expression="&quot;&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
