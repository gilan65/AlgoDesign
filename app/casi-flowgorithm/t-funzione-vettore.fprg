<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="t-funzione-vettore"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="w" type="Integer" array="True" size="5"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <assign variable="w[i]" expression="i + 1"/>
            </for>
            <output expression="&quot;S &quot; &amp; Somma(w)" newline="True"/>
        </body>
    </function>
    <function name="Somma" type="Integer" variable="s">
        <parameters>
            <parameter name="v" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="s" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="s" expression="0"/>
            <for variable="i" start="0" end="Size(v) - 1" direction="inc" step="1">
                <assign variable="s" expression="s + v[i]"/>
            </for>
        </body>
    </function>
</flowgorithm>
