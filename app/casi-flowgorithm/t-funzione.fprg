<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="t-funzione"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Q &quot; &amp; Quadrato(4)" newline="True"/>
            <output expression="&quot;M &quot; &amp; Media(1, 2)" newline="True"/>
        </body>
    </function>
    <function name="Media" type="Real" variable="m">
        <parameters>
            <parameter name="a" type="Real" array="False"/>
            <parameter name="b" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="m" type="Real" array="False" size=""/>
            <assign variable="m" expression="(a + b) / 2"/>
        </body>
    </function>
    <function name="Quadrato" type="Integer" variable="r">
        <parameters>
            <parameter name="x" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="r" type="Integer" array="False" size=""/>
            <assign variable="r" expression="x * x"/>
        </body>
    </function>
</flowgorithm>
