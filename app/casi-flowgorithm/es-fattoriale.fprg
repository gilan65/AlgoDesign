<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="es-fattoriale"/>
        <attribute name="authors" value="prova"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-14 06:00:00 PM"/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n" type="Integer" array="False" size=""/>
            <output expression="&quot;!&quot;" newline="False"/>
            <for variable="n" start="0" end="5" direction="inc" step="1">
                <output expression="&quot; &quot; &amp; Fattoriale(n)" newline="False"/>
            </for>
            <output expression="&quot;&quot;" newline="True"/>
        </body>
    </function>
    <function name="Fattoriale" type="Integer" variable="f">
        <parameters>
            <parameter name="n" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="f" type="Integer" array="False" size=""/>
            <if expression="n &lt;= 1">
                <then>
                    <assign variable="f" expression="1"/>
                </then>
                <else>
                    <assign variable="f" expression="n * Fattoriale(n - 1)"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
