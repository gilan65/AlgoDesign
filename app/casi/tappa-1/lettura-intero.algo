{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "lettura-intero",
    "description": "Lettura di un intero con uno spazio prima."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "n",
          "type": "integer",
          "role": "input"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "read",
          "target": "n"
        },
        {
          "id": "b2",
          "kind": "write",
          "values": [
            "n * 2"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b3"
      }
    }
  ],
  "test_cases": [
    {
      "name": "lettura-intero",
      "inputs": [
        {
          "data": "n",
          "text": " 21"
        }
      ],
      "expected": {
        "output": "42\n"
      }
    },
    {
      "name": "negativo",
      "description": "Il doppio arriva esattamente all'intero più piccolo, senza traboccare.",
      "inputs": [
        {
          "data": "n",
          "text": "-1073741824"
        }
      ],
      "expected": {
        "output": "-2147483648\n"
      }
    }
  ]
}
