{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "intero-troppo-lungo",
    "description": "Una riga di 5000 cifre letta come intero: fuori dall'intervallo, l'input non è valido."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "n",
          "type": "integer",
          "role": "input"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "read",
          "target": "n"
        },
        {
          "id": "b2",
          "kind": "write",
          "values": [
            "n"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b3"
      }
    }
  ],
  "test_cases": [
    {
      "name": "intero-troppo-lungo",
      "inputs": [
        {
          "data": "n",
          "text": ""
        }
      ],
      "expected": {
        "output": "",
        "error": {
          "code": "invalid_input",
          "block": "b1"
        }
      }
    }
  ]
}
