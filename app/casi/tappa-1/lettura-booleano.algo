{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "lettura-booleano",
    "description": "Lettura di un booleano."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "b",
          "type": "boolean",
          "role": "input"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "read",
          "target": "b"
        },
        {
          "id": "b2",
          "kind": "if",
          "condition": "b",
          "then": [
            {
              "id": "b3",
              "kind": "write",
              "values": [
                "\"sì\""
              ],
              "newline": true
            }
          ],
          "else": [
            {
              "id": "b4",
              "kind": "write",
              "values": [
                "\"no\""
              ],
              "newline": true
            }
          ]
        }
      ],
      "end": {
        "id": "b5"
      }
    }
  ],
  "test_cases": [
    {
      "name": "lettura-booleano",
      "inputs": [
        {
          "data": "b",
          "text": "true"
        }
      ],
      "expected": {
        "output": "sì\n"
      }
    }
  ]
}
