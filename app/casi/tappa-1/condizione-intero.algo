{
  "format": "algodesign",
  "schema_version": 2,
  "metadata": {
    "name": "condizione-intero",
    "description": "Pari o dispari con mod."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "n",
          "type": "integer",
          "initial": "7"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "if",
          "condition": "n mod 2 == 0",
          "then": [
            {
              "id": "b2",
              "kind": "write",
              "values": [
                "\"pari\""
              ],
              "newline": true
            }
          ],
          "else": [
            {
              "id": "b3",
              "kind": "write",
              "values": [
                "\"dispari\""
              ],
              "newline": true
            }
          ]
        }
      ],
      "end": {
        "id": "b4"
      }
    }
  ],
  "test_cases": [
    {
      "name": "condizione-intero",
      "inputs": [],
      "expected": {
        "output": "dispari\n"
      }
    }
  ]
}
