{
  "format": "algodesign",
  "schema_version": 2,
  "metadata": {
    "name": "ritorno-in-coda-al-tetto",
    "description": "La funzione «ponte», fuori dal giro, restituisce direttamente il valore di «conta», che richiama sé stessa: con k = 500 la chiamata di «conta» è la cinquecentunesima in corso, e l'esecuzione si ferma sulla fine di «ponte», dove sta la chiamata."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "k",
          "type": "integer"
        },
        {
          "name": "r",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "read",
          "target": "k"
        },
        {
          "id": "b2",
          "kind": "assignment",
          "target": "r",
          "value": "esterna(k)"
        },
        {
          "id": "b3",
          "kind": "write",
          "values": [
            "r"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b4"
      }
    },
    {
      "id": "f2",
      "kind": "function",
      "name": "esterna",
      "return_type": "integer",
      "data": [
        {
          "name": "n",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "x",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b5",
          "kind": "if",
          "condition": "n > 1",
          "then": [
            {
              "id": "b6",
              "kind": "assignment",
              "target": "x",
              "value": "esterna(n - 1)"
            }
          ],
          "else": [
            {
              "id": "b7",
              "kind": "assignment",
              "target": "x",
              "value": "ponte(0)"
            }
          ]
        }
      ],
      "end": {
        "id": "b8",
        "return_value": "x"
      }
    },
    {
      "id": "f3",
      "kind": "function",
      "name": "ponte",
      "return_type": "integer",
      "data": [
        {
          "name": "m",
          "type": "integer",
          "parameter": "value"
        }
      ],
      "body": [],
      "end": {
        "id": "b9",
        "return_value": "conta(m)"
      }
    },
    {
      "id": "f4",
      "kind": "function",
      "name": "conta",
      "return_type": "integer",
      "data": [
        {
          "name": "q",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "t",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b10",
          "kind": "if",
          "condition": "q > 0",
          "then": [
            {
              "id": "b11",
              "kind": "assignment",
              "target": "t",
              "value": "conta(q - 1)"
            }
          ],
          "else": [
            {
              "id": "b12",
              "kind": "assignment",
              "target": "t",
              "value": "0"
            }
          ]
        }
      ],
      "end": {
        "id": "b13",
        "return_value": "t + 1"
      }
    }
  ],
  "test_cases": [
    {
      "name": "quattrocentonovantanove",
      "inputs": [
        {
          "data": "k",
          "text": "499"
        }
      ],
      "expected": {
        "output": "1\n"
      }
    },
    {
      "name": "cinquecento",
      "inputs": [
        {
          "data": "k",
          "text": "500"
        }
      ],
      "expected": {
        "output": "",
        "error": {
          "code": "recursion_too_deep",
          "block": "b9"
        }
      }
    }
  ]
}
