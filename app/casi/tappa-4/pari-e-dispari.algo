{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "pari-e-dispari",
    "description": "La ricorsione indiretta: pari chiama dispari, che chiama pari, finché n arriva a 0."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "n",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "read",
          "target": "n"
        },
        {
          "id": "b2",
          "kind": "write",
          "values": [
            "pari(n)"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b3"
      }
    },
    {
      "id": "f2",
      "kind": "function",
      "name": "pari",
      "return_type": "boolean",
      "data": [
        {
          "name": "n",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "p",
          "type": "boolean"
        }
      ],
      "body": [
        {
          "id": "b4",
          "kind": "if",
          "condition": "n == 0",
          "then": [
            {
              "id": "b5",
              "kind": "assignment",
              "target": "p",
              "value": "true"
            }
          ],
          "else": [
            {
              "id": "b6",
              "kind": "assignment",
              "target": "p",
              "value": "dispari(n - 1)"
            }
          ]
        }
      ],
      "end": {
        "id": "b7",
        "return_value": "p"
      }
    },
    {
      "id": "f3",
      "kind": "function",
      "name": "dispari",
      "return_type": "boolean",
      "data": [
        {
          "name": "n",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "d",
          "type": "boolean"
        }
      ],
      "body": [
        {
          "id": "b8",
          "kind": "if",
          "condition": "n == 0",
          "then": [
            {
              "id": "b9",
              "kind": "assignment",
              "target": "d",
              "value": "false"
            }
          ],
          "else": [
            {
              "id": "b10",
              "kind": "assignment",
              "target": "d",
              "value": "pari(n - 1)"
            }
          ]
        }
      ],
      "end": {
        "id": "b11",
        "return_value": "d"
      }
    }
  ],
  "test_cases": [
    {
      "name": "sette",
      "inputs": [
        {
          "data": "n",
          "text": "7"
        }
      ],
      "expected": {
        "output": "false\n"
      }
    },
    {
      "name": "dieci",
      "inputs": [
        {
          "data": "n",
          "text": "10"
        }
      ],
      "expected": {
        "output": "true\n"
      }
    }
  ]
}
