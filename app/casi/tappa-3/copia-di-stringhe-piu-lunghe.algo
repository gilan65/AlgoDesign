{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "copia-di-stringhe-piu-lunghe",
    "description": "La copia di un vettore di stringhe col suo nome, e un vettore di stringhe restituito, in un vettore con gli elementi più corti: ogni elemento si controlla contro la lunghezza massima di chi lo riceve, e il primo più lungo ferma l'assegnazione."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "lunghi",
          "type": "string",
          "size": 2,
          "initial": [
            "\"ab\"",
            "\"zz\""
          ],
          "max_length": 20
        },
        {
          "name": "corti",
          "type": "string",
          "size": 2,
          "max_length": 5
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "read",
          "target": "lunghi[1]"
        },
        {
          "id": "b2",
          "kind": "assignment",
          "target": "corti",
          "value": "lunghi"
        },
        {
          "id": "b3",
          "kind": "write",
          "values": [
            "corti[0]",
            "\" \"",
            "corti[1]"
          ],
          "newline": true
        },
        {
          "id": "b4",
          "kind": "assignment",
          "target": "corti",
          "value": "nomi()"
        },
        {
          "id": "b5",
          "kind": "write",
          "values": [
            "corti[1]"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b6"
      }
    },
    {
      "id": "f2",
      "kind": "function",
      "name": "nomi",
      "return_type": "string",
      "return_size": 2,
      "return_max_length": 9,
      "data": [
        {
          "name": "n",
          "type": "string",
          "size": 2,
          "initial": [
            "\"Anna\"",
            "\"Benedetta\""
          ],
          "max_length": 9
        }
      ],
      "body": [],
      "end": {
        "id": "b7",
        "return_value": "n"
      },
      "test_cases": [
        {
          "name": "da sola",
          "inputs": [],
          "expected": {
            "output": "→ [0] = Anna\n→ [1] = Benedetta\n"
          }
        }
      ]
    }
  ],
  "test_cases": [
    {
      "name": "corti",
      "inputs": [
        {
          "data": "lunghi",
          "text": "cd"
        }
      ],
      "expected": {
        "output": "ab cd\n",
        "error": {
          "code": "string_too_long",
          "block": "b4"
        }
      }
    },
    {
      "name": "lungo",
      "inputs": [
        {
          "data": "lunghi",
          "text": "abcdefg"
        }
      ],
      "expected": {
        "output": "",
        "error": {
          "code": "string_too_long",
          "block": "b2"
        }
      }
    }
  ]
}
