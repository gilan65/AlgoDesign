{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "vettore-di-dimensione-diversa",
    "description": "Il vettore restituito non ha la dimensione del vettore che lo riceve: errore statico, il programma non parte."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "voti",
          "type": "integer",
          "size": 3,
          "initial": [
            "7",
            "4",
            "9"
          ]
        },
        {
          "name": "altri",
          "type": "integer",
          "size": 4
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "assignment",
          "target": "altri",
          "value": "doppi(voti)"
        },
        {
          "id": "b2",
          "kind": "write",
          "values": [
            "altri[0]"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b3"
      }
    },
    {
      "id": "f2",
      "kind": "function",
      "name": "doppi",
      "return_type": "integer",
      "return_size": 3,
      "data": [
        {
          "name": "w",
          "type": "integer",
          "size": 3,
          "parameter": "value"
        },
        {
          "name": "r",
          "type": "integer",
          "size": 3,
          "initial": {
            "each": "0"
          }
        },
        {
          "name": "i",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b4",
          "kind": "for",
          "counter": "i",
          "from": "0",
          "to": "2",
          "body": [
            {
              "id": "b5",
              "kind": "assignment",
              "target": "r[i]",
              "value": "w[i] * 2"
            }
          ]
        }
      ],
      "end": {
        "id": "b6",
        "return_value": "r"
      }
    }
  ],
  "test_cases": [
    {
      "name": "vettore-di-dimensione-diversa",
      "inputs": [],
      "expected": {
        "output": "",
        "static_error": {
          "code": "array_assignment",
          "block": "b1"
        }
      }
    }
  ]
}
