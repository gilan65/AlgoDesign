{
  "format": "algodesign",
  "schema_version": 2,
  "metadata": {
    "name": "importazione-dalla-libreria",
    "description": "Nato da un'importazione: il programma di riferimento della tappa 3 con ciò che entra dalla libreria dei voti. La procedura che legge il numero è identica e non entra di nuovo; la funzione che dice se un voto è valido è diversa ed entra rinominata, con la costante comune che usa; la media entra rinominata perché il programma ha un dato con quel nome, con la funzione che chiama; il giudizio entra con la funzione che chiama e chiama la funzione del voto valido col nome nuovo, e il suo caso che si ferma dentro di lei attende l'errore sul blocco nuovo; i casi d'uso entrano con loro."
  },
  "shared_constants": [
    {
      "name": "MAX_VOTI",
      "type": "integer",
      "constant": true,
      "initial": "12"
    }
  ],
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "n",
          "type": "integer",
          "role": "input"
        },
        {
          "name": "voto",
          "type": "integer",
          "role": "input"
        },
        {
          "name": "media",
          "type": "real",
          "role": "output"
        },
        {
          "name": "contati",
          "type": "integer",
          "initial": "0",
          "role": "output"
        },
        {
          "name": "insufficienti",
          "type": "integer",
          "initial": "0",
          "role": "output"
        },
        {
          "name": "somma",
          "type": "integer",
          "initial": "0"
        },
        {
          "name": "i",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "call",
          "callee": "leggi_numero",
          "arguments": [
            "n"
          ]
        },
        {
          "id": "b2",
          "kind": "for",
          "counter": "i",
          "from": "1",
          "to": "n",
          "body": [
            {
              "id": "b3",
              "kind": "read",
              "target": "voto"
            },
            {
              "id": "b4",
              "kind": "if",
              "condition": "valido(voto)",
              "then": [
                {
                  "id": "b5",
                  "kind": "assignment",
                  "target": "somma",
                  "value": "somma + voto"
                },
                {
                  "id": "b6",
                  "kind": "assignment",
                  "target": "contati",
                  "value": "contati + 1"
                },
                {
                  "id": "b7",
                  "kind": "if",
                  "condition": "voto < 6",
                  "then": [
                    {
                      "id": "b8",
                      "kind": "assignment",
                      "target": "insufficienti",
                      "value": "insufficienti + 1"
                    }
                  ],
                  "else": []
                }
              ],
              "else": [
                {
                  "id": "b9",
                  "kind": "write",
                  "values": [
                    "\"Voto ignorato: \"",
                    "voto"
                  ],
                  "newline": true
                }
              ]
            }
          ]
        },
        {
          "id": "b10",
          "kind": "if",
          "condition": "contati > 0",
          "then": [
            {
              "id": "b11",
              "kind": "assignment",
              "target": "media",
              "value": "to_real somma / to_real contati"
            },
            {
              "id": "b12",
              "kind": "write",
              "values": [
                "\"Media: \"",
                "media",
                "\" su \"",
                "contati",
                "\" voti, insufficienti: \"",
                "insufficienti"
              ],
              "newline": true
            },
            {
              "id": "b13",
              "kind": "call",
              "callee": "stelle",
              "arguments": [
                "somma / contati"
              ]
            }
          ],
          "else": [
            {
              "id": "b14",
              "kind": "write",
              "values": [
                "\"Nessun voto valido\""
              ],
              "newline": true
            }
          ]
        }
      ],
      "end": {
        "id": "b15"
      }
    },
    {
      "id": "f2",
      "kind": "procedure",
      "name": "leggi_numero",
      "data": [
        {
          "name": "numero",
          "type": "integer",
          "parameter": "out"
        }
      ],
      "body": [
        {
          "id": "b16",
          "kind": "comment",
          "text": "Si chiede quanti voti leggere, finché il numero non è fra 1 e 30"
        },
        {
          "id": "b17",
          "kind": "repeat",
          "body": [
            {
              "id": "b18",
              "kind": "read",
              "target": "numero"
            },
            {
              "id": "b19",
              "kind": "if",
              "condition": "numero < 1 or numero > 30",
              "then": [
                {
                  "id": "b20",
                  "kind": "write",
                  "values": [
                    "\"Numero non valido: da 1 a 30\""
                  ],
                  "newline": true
                }
              ],
              "else": []
            }
          ],
          "condition": "numero < 1 or numero > 30"
        }
      ],
      "end": {
        "id": "b21"
      }
    },
    {
      "id": "f3",
      "kind": "function",
      "name": "valido",
      "return_type": "boolean",
      "data": [
        {
          "name": "voto",
          "type": "integer",
          "parameter": "value"
        }
      ],
      "body": [],
      "end": {
        "id": "b22",
        "return_value": "voto >= 1 and voto <= 10"
      },
      "test_cases": [
        {
          "name": "voto valido",
          "inputs": [
            {
              "data": "voto",
              "text": "7"
            }
          ],
          "expected": {
            "output": "→ true\n"
          }
        },
        {
          "name": "voto troppo alto",
          "inputs": [
            {
              "data": "voto",
              "text": "11"
            }
          ],
          "expected": {
            "output": "→ false\n"
          }
        }
      ]
    },
    {
      "id": "f4",
      "kind": "procedure",
      "name": "stelle",
      "data": [
        {
          "name": "quante",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "k",
          "type": "integer",
          "initial": "0"
        }
      ],
      "body": [
        {
          "id": "b23",
          "kind": "while",
          "condition": "k < quante",
          "body": [
            {
              "id": "b24",
              "kind": "write",
              "values": [
                "\"*\""
              ],
              "newline": false
            },
            {
              "id": "b25",
              "kind": "assignment",
              "target": "k",
              "value": "k + 1"
            }
          ]
        },
        {
          "id": "b26",
          "kind": "write",
          "values": [
            "\"\""
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b27"
      },
      "test_cases": [
        {
          "name": "tre stelle",
          "inputs": [
            {
              "data": "quante",
              "text": "3"
            }
          ],
          "expected": {
            "output": "***\n"
          }
        }
      ]
    },
    {
      "id": "f5",
      "kind": "function",
      "name": "valido_2",
      "return_type": "boolean",
      "data": [
        {
          "name": "voto",
          "type": "integer",
          "parameter": "value"
        }
      ],
      "body": [],
      "end": {
        "id": "b28",
        "return_value": "voto >= 0 and voto <= MAX_VOTI"
      },
      "test_cases": [
        {
          "name": "zero",
          "inputs": [
            {
              "data": "voto",
              "text": "0"
            }
          ],
          "expected": {
            "output": "→ true\n"
          }
        }
      ]
    },
    {
      "id": "f6",
      "kind": "function",
      "name": "somma_di",
      "return_type": "integer",
      "data": [
        {
          "name": "v",
          "type": "integer",
          "size": 3,
          "parameter": "value"
        },
        {
          "name": "quanti",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "s",
          "type": "integer",
          "initial": "0"
        },
        {
          "name": "i",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b29",
          "kind": "for",
          "counter": "i",
          "from": "0",
          "to": "quanti - 1",
          "body": [
            {
              "id": "b30",
              "kind": "assignment",
              "target": "s",
              "value": "s + v[i]"
            }
          ]
        }
      ],
      "end": {
        "id": "b31",
        "return_value": "s"
      },
      "test_cases": [
        {
          "name": "tre",
          "inputs": [
            {
              "data": "v",
              "text": "1"
            },
            {
              "data": "v",
              "text": "2"
            },
            {
              "data": "v",
              "text": "3"
            },
            {
              "data": "quanti",
              "text": "3"
            }
          ],
          "expected": {
            "output": "→ 6\n"
          }
        }
      ]
    },
    {
      "id": "f7",
      "kind": "function",
      "name": "media_2",
      "return_type": "real",
      "data": [
        {
          "name": "v",
          "type": "integer",
          "size": 3,
          "parameter": "value"
        },
        {
          "name": "quanti",
          "type": "integer",
          "parameter": "value"
        }
      ],
      "body": [],
      "end": {
        "id": "b32",
        "return_value": "to_real somma_di(v, quanti) / to_real quanti"
      },
      "test_cases": [
        {
          "name": "tre voti",
          "inputs": [
            {
              "data": "v",
              "text": "6"
            },
            {
              "data": "v",
              "text": "7"
            },
            {
              "data": "v",
              "text": "9"
            },
            {
              "data": "quanti",
              "text": "3"
            }
          ],
          "expected": {
            "output": "→ 7.33\n"
          }
        }
      ]
    },
    {
      "id": "f8",
      "kind": "function",
      "name": "stelle_di",
      "return_type": "string",
      "return_max_length": 10,
      "data": [
        {
          "name": "quante",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "s",
          "type": "string",
          "initial": "\"\"",
          "max_length": 10
        },
        {
          "name": "i",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b33",
          "kind": "for",
          "counter": "i",
          "from": "1",
          "to": "quante",
          "body": [
            {
              "id": "b34",
              "kind": "assignment",
              "target": "s",
              "value": "s + \"*\""
            }
          ]
        }
      ],
      "end": {
        "id": "b35",
        "return_value": "s"
      },
      "test_cases": [
        {
          "name": "tre",
          "inputs": [
            {
              "data": "quante",
              "text": "3"
            }
          ],
          "expected": {
            "output": "→ ***\n"
          }
        }
      ]
    },
    {
      "id": "f9",
      "kind": "function",
      "name": "giudizio",
      "return_type": "string",
      "data": [
        {
          "name": "voto",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "g",
          "type": "string"
        }
      ],
      "body": [
        {
          "id": "b36",
          "kind": "if",
          "condition": "valido_2(voto)",
          "then": [
            {
              "id": "b37",
              "kind": "assignment",
              "target": "g",
              "value": "\"voto \" + stelle_di(voto)"
            }
          ],
          "else": [
            {
              "id": "b38",
              "kind": "assignment",
              "target": "g",
              "value": "\"non valido\""
            }
          ]
        }
      ],
      "end": {
        "id": "b39",
        "return_value": "g"
      },
      "test_cases": [
        {
          "name": "sette",
          "inputs": [
            {
              "data": "voto",
              "text": "7"
            }
          ],
          "expected": {
            "output": "→ voto *******\n"
          }
        },
        {
          "name": "troppe stelle",
          "inputs": [
            {
              "data": "voto",
              "text": "11"
            }
          ],
          "expected": {
            "output": "",
            "error": {
              "code": "string_too_long",
              "block": "b34"
            }
          }
        },
        {
          "name": "tredici",
          "inputs": [
            {
              "data": "voto",
              "text": "13"
            }
          ],
          "expected": {
            "output": "→ non valido\n"
          }
        }
      ]
    }
  ],
  "test_cases": [
    {
      "name": "riferimento-media-voti-funzioni",
      "inputs": [
        {
          "data": "n",
          "text": "0"
        },
        {
          "data": "n",
          "text": "4"
        },
        {
          "data": "voto",
          "text": "7"
        },
        {
          "data": "voto",
          "text": "11"
        },
        {
          "data": "voto",
          "text": "5"
        },
        {
          "data": "voto",
          "text": "8"
        }
      ],
      "expected": {
        "output": "Numero non valido: da 1 a 30\nVoto ignorato: 11\nMedia: 6.67 su 3 voti, insufficienti: 1\n******\n"
      }
    }
  ]
}
