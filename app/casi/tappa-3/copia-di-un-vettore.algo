{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "copia-di-un-vettore",
    "description": "La copia di un vettore col suo nome, elemento per elemento, e il vettore restituito da una funzione che restituisce una costante comune: chi riceve ha una copia, e cambiarla non cambia la sorgente."
  },
  "shared_constants": [
    {
      "name": "PRIMI",
      "type": "integer",
      "size": 3,
      "constant": true,
      "initial": [
        "2",
        "3",
        "5"
      ]
    }
  ],
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "voti",
          "type": "integer",
          "size": 3,
          "initial": [
            "7",
            "4",
            "9"
          ]
        },
        {
          "name": "altri",
          "type": "integer",
          "size": 3
        },
        {
          "name": "v",
          "type": "integer",
          "size": 3
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "assignment",
          "target": "altri",
          "value": "voti"
        },
        {
          "id": "b2",
          "kind": "assignment",
          "target": "altri[0]",
          "value": "1"
        },
        {
          "id": "b3",
          "kind": "assignment",
          "target": "v",
          "value": "primi()"
        },
        {
          "id": "b4",
          "kind": "assignment",
          "target": "v[0]",
          "value": "1"
        },
        {
          "id": "b5",
          "kind": "write",
          "values": [
            "voti[0]",
            "\" \"",
            "altri[0]",
            "\" \"",
            "PRIMI[0]",
            "\" \"",
            "v[0]"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b6"
      }
    },
    {
      "id": "f2",
      "kind": "function",
      "name": "primi",
      "return_type": "integer",
      "return_size": 3,
      "data": [],
      "body": [],
      "end": {
        "id": "b7",
        "return_value": "PRIMI"
      }
    }
  ],
  "test_cases": [
    {
      "name": "copia-di-un-vettore",
      "inputs": [],
      "expected": {
        "output": "7 1 2 1\n"
      }
    }
  ]
}
