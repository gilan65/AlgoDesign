{
  "format": "algodesign",
  "schema_version": 2,
  "metadata": {
    "name": "stringa-lunga-nella-funzione",
    "description": "Una stringa troppo lunga per il parametro di una funzione, e una chiamata alla sua destra che si ferma: si ferma prima la stringa."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "s",
          "type": "string",
          "initial": "\"abc\"",
          "max_length": 3
        },
        {
          "name": "r",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "assignment",
          "target": "r",
          "value": "f(s + \"d\", g(5))"
        },
        {
          "id": "b2",
          "kind": "write",
          "values": [
            "r"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b3"
      }
    },
    {
      "id": "f2",
      "kind": "function",
      "name": "f",
      "return_type": "integer",
      "data": [
        {
          "name": "x",
          "type": "string",
          "max_length": 3,
          "parameter": "value"
        },
        {
          "name": "n",
          "type": "integer",
          "parameter": "value"
        }
      ],
      "body": [],
      "end": {
        "id": "b4",
        "return_value": "to_integer x[0] + n"
      }
    },
    {
      "id": "f3",
      "kind": "function",
      "name": "g",
      "return_type": "integer",
      "data": [
        {
          "name": "k",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "t",
          "type": "string",
          "initial": "\"abc\""
        }
      ],
      "body": [],
      "end": {
        "id": "b5",
        "return_value": "to_integer t[k]"
      }
    }
  ],
  "test_cases": [
    {
      "name": "stringa-lunga-nella-funzione",
      "inputs": [],
      "expected": {
        "output": "",
        "error": {
          "code": "string_too_long",
          "block": "b1"
        }
      }
    }
  ]
}
