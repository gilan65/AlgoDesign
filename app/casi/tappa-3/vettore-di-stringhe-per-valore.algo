{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "vettore-di-stringhe-per-valore",
    "description": "Un vettore di stringhe senza rif: la procedura cambia la sua copia, e il vettore di chi chiama resta com'era."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "v",
          "type": "string",
          "size": 2,
          "initial": [
            "\"a\"",
            "\"b\""
          ]
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "call",
          "callee": "cambia",
          "arguments": [
            "v"
          ]
        },
        {
          "id": "b2",
          "kind": "write",
          "values": [
            "v[0]",
            "v[1]"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b3"
      }
    },
    {
      "id": "f2",
      "kind": "procedure",
      "name": "cambia",
      "data": [
        {
          "name": "w",
          "type": "string",
          "size": 2,
          "parameter": "value"
        }
      ],
      "body": [
        {
          "id": "b4",
          "kind": "assignment",
          "target": "w[0]",
          "value": "w[0] + \"z\""
        },
        {
          "id": "b5",
          "kind": "write",
          "values": [
            "w[0]",
            "w[1]"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b6"
      }
    }
  ],
  "test_cases": [
    {
      "name": "vettore-di-stringhe-per-valore",
      "inputs": [],
      "expected": {
        "output": "azb\nab\n"
      }
    }
  ]
}
