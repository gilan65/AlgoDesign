{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "scrittura-con-funzione-che-si-ferma",
    "description": "Una scrittura con due valori, il secondo da una funzione che si ferma: la scrittura scrive un valore alla volta, quindi il primo resta scritto."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [],
      "body": [
        {
          "id": "b1",
          "kind": "write",
          "values": [
            "\"inizio: \"",
            "primo(5)"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b2"
      }
    },
    {
      "id": "f2",
      "kind": "function",
      "name": "primo",
      "return_type": "integer",
      "data": [
        {
          "name": "k",
          "type": "integer",
          "parameter": "value"
        },
        {
          "name": "t",
          "type": "string",
          "initial": "\"abc\""
        }
      ],
      "body": [],
      "end": {
        "id": "b3",
        "return_value": "to_integer t[k]"
      }
    }
  ],
  "test_cases": [
    {
      "name": "scrittura-con-funzione-che-si-ferma",
      "inputs": [],
      "expected": {
        "output": "inizio: ",
        "error": {
          "code": "index_out_of_range",
          "block": "b3"
        }
      }
    }
  ]
}
