{
  "format": "algodesign",
  "schema_version": 2,
  "metadata": {
    "name": "riferimento-a-un-record-senza-valore",
    "description": "Un record senza nessun campo con un valore passato per riferimento ferma il salto; con un campo, la procedura parte."
  },
  "records": [
    {
      "name": "alunno",
      "fields": [
        {
          "name": "nome",
          "type": "string",
          "max_length": 20
        },
        {
          "name": "classe",
          "type": "string",
          "max_length": 3
        },
        {
          "name": "voto",
          "type": "integer"
        }
      ]
    }
  ],
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "n",
          "type": "integer"
        },
        {
          "name": "c",
          "type": "record",
          "record": "alunno"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "read",
          "target": "n"
        },
        {
          "id": "b2",
          "kind": "if",
          "condition": "n > 0",
          "then": [
            {
              "id": "b3",
              "kind": "assignment",
              "target": "c.voto",
              "value": "5"
            }
          ],
          "else": []
        },
        {
          "id": "b4",
          "kind": "call",
          "callee": "promuovi",
          "arguments": [
            "c"
          ]
        },
        {
          "id": "b5",
          "kind": "write",
          "values": [
            "c.voto"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "fine"
      }
    },
    {
      "id": "f2",
      "kind": "procedure",
      "name": "promuovi",
      "data": [
        {
          "name": "r",
          "type": "record",
          "record": "alunno",
          "parameter": "reference"
        }
      ],
      "body": [
        {
          "id": "b6",
          "kind": "assignment",
          "target": "r.voto",
          "value": "r.voto + 1"
        }
      ],
      "end": {
        "id": "b7"
      }
    }
  ],
  "test_cases": [
    {
      "name": "senza-valore",
      "inputs": [
        {
          "data": "n",
          "text": "0"
        }
      ],
      "expected": {
        "output": "",
        "error": {
          "code": "reference_without_value",
          "block": "b4"
        },
        "warnings": [
          {
            "code": "maybe_uninitialized",
            "block": "b4"
          }
        ]
      }
    },
    {
      "name": "con-un-campo",
      "inputs": [
        {
          "data": "n",
          "text": "1"
        }
      ],
      "expected": {
        "output": "6\n",
        "warnings": [
          {
            "code": "maybe_uninitialized",
            "block": "b4"
          }
        ]
      }
    }
  ]
}
