{
  "format": "algodesign",
  "schema_version": 2,
  "metadata": {
    "name": "per-ogni-su-riga-da-una-funzione",
    "description": "Il «per ogni» su una riga il cui indice è una chiamata: si calcola una volta, alla partenza, anche se il corpo cambia il dato da cui dipende."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "m",
          "type": "integer",
          "size": 2,
          "columns": 2,
          "initial": [
            [
              "1",
              "2"
            ],
            [
              "3",
              "4"
            ]
          ]
        },
        {
          "name": "k",
          "type": "integer",
          "initial": "0"
        },
        {
          "name": "x",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "for_each",
          "item": "x",
          "source": "m[quale(k)]",
          "body": [
            {
              "id": "b2",
              "kind": "write",
              "values": [
                "x",
                "\" \""
              ],
              "newline": false
            },
            {
              "id": "b3",
              "kind": "assignment",
              "target": "k",
              "value": "1"
            }
          ]
        },
        {
          "id": "b4",
          "kind": "write",
          "values": [
            "\"|\""
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "fine"
      }
    },
    {
      "id": "f2",
      "kind": "function",
      "name": "quale",
      "return_type": "integer",
      "data": [
        {
          "name": "n",
          "type": "integer",
          "parameter": "value"
        }
      ],
      "body": [],
      "end": {
        "id": "g1",
        "return_value": "n"
      }
    }
  ],
  "test_cases": [
    {
      "name": "per-ogni-su-riga-da-una-funzione",
      "inputs": [],
      "expected": {
        "output": "1 2 |\n"
      }
    }
  ]
}
