{
  "format": "algodesign",
  "schema_version": 2,
  "metadata": {
    "name": "booleani-assegnati-e-confrontati",
    "description": "Un booleano assegnato con un valore e poi confrontato: un campo, un elemento, il campo di un record di una tabella, con not, and e or."
  },
  "records": [
    {
      "name": "esito",
      "fields": [
        {
          "name": "promosso",
          "type": "boolean"
        },
        {
          "name": "voto",
          "type": "integer"
        }
      ]
    }
  ],
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "a",
          "type": "record",
          "record": "esito"
        },
        {
          "name": "t",
          "type": "record",
          "record": "esito",
          "size": 2
        },
        {
          "name": "v",
          "type": "boolean",
          "size": 2
        },
        {
          "name": "p",
          "type": "boolean"
        },
        {
          "name": "q",
          "type": "boolean"
        },
        {
          "name": "i",
          "type": "integer",
          "initial": "1"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "assignment",
          "target": "a.promosso",
          "value": "true"
        },
        {
          "id": "b2",
          "kind": "if",
          "condition": "a.promosso == false",
          "then": [
            {
              "id": "b2a",
              "kind": "write",
              "values": [
                "\"1\""
              ],
              "newline": false
            }
          ],
          "else": [
            {
              "id": "b2b",
              "kind": "write",
              "values": [
                "\"a\""
              ],
              "newline": false
            }
          ]
        },
        {
          "id": "b3",
          "kind": "assignment",
          "target": "v[0]",
          "value": "true"
        },
        {
          "id": "b4",
          "kind": "if",
          "condition": "v[0] == false",
          "then": [
            {
              "id": "b4a",
              "kind": "write",
              "values": [
                "\"2\""
              ],
              "newline": false
            }
          ],
          "else": [
            {
              "id": "b4b",
              "kind": "write",
              "values": [
                "\"b\""
              ],
              "newline": false
            }
          ]
        },
        {
          "id": "b5",
          "kind": "assignment",
          "target": "v[i]",
          "value": "false"
        },
        {
          "id": "b6",
          "kind": "if",
          "condition": "v[i] != false",
          "then": [
            {
              "id": "b6a",
              "kind": "write",
              "values": [
                "\"3\""
              ],
              "newline": false
            }
          ],
          "else": [
            {
              "id": "b6b",
              "kind": "write",
              "values": [
                "\"c\""
              ],
              "newline": false
            }
          ]
        },
        {
          "id": "b7",
          "kind": "assignment",
          "target": "t[0].promosso",
          "value": "false"
        },
        {
          "id": "b8",
          "kind": "if",
          "condition": "t[0].promosso == true",
          "then": [
            {
              "id": "b8a",
              "kind": "write",
              "values": [
                "\"4\""
              ],
              "newline": false
            }
          ],
          "else": [
            {
              "id": "b8b",
              "kind": "write",
