                "\"d\""
              ],
              "newline": false
            }
          ]
        },
        {
          "id": "b9",
          "kind": "assignment",
          "target": "t[i].promosso",
          "value": "true"
        },
        {
          "id": "b10",
          "kind": "if",
          "condition": "t[i].promosso == false",
          "then": [
            {
              "id": "b10a",
              "kind": "write",
              "values": [
                "\"5\""
              ],
              "newline": false
            }
          ],
          "else": [
            {
              "id": "b10b",
              "kind": "write",
              "values": [
                "\"e\""
              ],
              "newline": false
            }
          ]
        },
        {
          "id": "b11",
          "kind": "assignment",
          "target": "p",
          "value": "true"
        },
        {
          "id": "b12",
          "kind": "assignment",
          "target": "q",
          "value": "false"
