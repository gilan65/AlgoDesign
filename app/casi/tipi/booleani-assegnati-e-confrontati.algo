            }
          ],
          "else": [
            {
              "id": "b13b",
              "kind": "write",
              "values": [
                "\"f\""
              ],
              "newline": false
            }
          ]
        },
        {
          "id": "b14",
          "kind": "if",
          "condition": "(p and q) == true",
          "then": [
            {
              "id": "b14a",
              "kind": "write",
              "values": [
                "\"7\""
              ],
              "newline": false
            }
          ],
          "else": [
            {
              "id": "b14b",
