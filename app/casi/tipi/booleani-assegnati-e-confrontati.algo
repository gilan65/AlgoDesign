          ]
        },
        {
          "id": "b16",
          "kind": "if",
          "condition": "p == q",
          "then": [
            {
              "id": "b16a",
              "kind": "write",
              "values": [
                "\"9\""
              ],
              "newline": false
            }
          ],
          "else": [
            {
              "id": "b16b",
              "kind": "write",
              "values": [
