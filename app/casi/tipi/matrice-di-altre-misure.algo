{
  "format": "algodesign",
  "schema_version": 2,
  "metadata": {
    "name": "matrice-di-altre-misure",
    "description": "Una matrice riceve col nome solo una matrice delle stesse righe e delle stesse colonne."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "a",
          "type": "integer",
          "size": 2,
          "columns": 2,
          "initial": {
            "each": "1"
          }
        },
        {
          "name": "b",
          "type": "integer",
          "size": 2,
          "columns": 3
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "assignment",
          "target": "b",
          "value": "a"
        },
        {
          "id": "b2",
          "kind": "write",
          "values": [
            "b[0][0]"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "fine"
      }
    }
  ],
  "test_cases": [
    {
      "name": "matrice-di-altre-misure",
      "inputs": [],
      "expected": {
        "output": "",
        "static_error": {
          "code": "array_assignment",
          "block": "b1"
        }
      }
    }
  ]
}
