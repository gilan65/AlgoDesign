      "body": [
        {
          "id": "l1",
          "kind": "assignment",
          "target": "x[1].voto",
          "value": "100"
        }
      ],
      "end": {
        "id": "l2",
        "return_value": "x"
      },
      "test_cases": [
        {
          "name": "da-sola",
          "inputs": [
            {
              "data": "x",
              "text": "A"
            },
            {
              "data": "x",
              "text": "1A"
            },
            {
              "data": "x",
              "text": "1"
            },
            {
              "data": "x",
              "text": "B"
            },
            {
              "data": "x",
              "text": "1B"
            },
            {
              "data": "x",
              "text": "2"
            },
            {
              "data": "x",
              "text": "C"
            },
            {
              "data": "x",
              "text": "1C"
            },
            {
              "data": "x",
              "text": "3"
            }
          ],
          "expected": {
            "output": "→ [0].nome = A\n→ [0].classe = 1A\n→ [0].voto = 1\n→ [1].nome = B\n→ [1].classe = 1B\n→ [1].voto = 100\n→ [2].nome = C\n→ [2].classe = 1C\n→ [2].voto = 3\n"
          }
        }
      ]
    },
    {
      "id": "f6",
      "kind": "function",
      "name": "iniziali",
      "return_type": "record",
      "return_record": "alunno",
      "return_size": 3,
