{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "per-passo-zero",
    "description": "Un ciclo per col passo zero: errore statico."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "i",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "for",
          "counter": "i",
          "from": "1",
          "to": "3",
          "step": 0,
          "body": [
            {
              "id": "b2",
              "kind": "write",
              "values": [
                "i"
              ],
              "newline": true
            }
          ]
        }
      ],
      "end": {
        "id": "b3"
      }
    }
  ],
  "test_cases": [
    {
      "name": "per-passo-zero",
      "inputs": [],
      "expected": {
        "output": "",
        "static_error": {
          "code": "invalid_step",
          "block": "b1"
        }
      }
    }
  ]
}
