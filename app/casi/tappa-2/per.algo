{
  "format": "algodesign",
  "schema_version": 1,
  "metadata": {
    "name": "per",
    "description": "Ciclo per con passo 2 e con passo -1; il contatore dopo il primo ciclo."
  },
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "i",
          "type": "integer"
        }
      ],
      "body": [
        {
          "id": "b1",
          "kind": "for",
          "counter": "i",
          "from": "1",
          "to": "5",
          "step": 2,
          "body": [
            {
              "id": "b2",
              "kind": "write",
              "values": [
                "i",
                "\" \""
              ],
              "newline": false
            }
          ]
        },
        {
          "id": "b3",
          "kind": "write",
          "values": [
            "\"| \"",
            "i",
            "\" | \""
          ],
          "newline": false
        },
        {
          "id": "b4",
          "kind": "for",
          "counter": "i",
          "from": "3",
          "to": "1",
          "step": -1,
          "body": [
            {
              "id": "b5",
              "kind": "write",
              "values": [
                "i"
              ],
              "newline": false
            }
          ]
        },
        {
          "id": "b6",
          "kind": "write",
          "values": [
            "\".\""
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b7"
      }
    }
  ],
  "test_cases": [
    {
      "name": "per",
      "inputs": [],
      "expected": {
        "output": "1 3 5 | 7 | 321.\n"
      }
    }
  ]
}
