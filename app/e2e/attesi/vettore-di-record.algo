{
  "format": "algodesign",
  "schema_version": 2,
  "metadata": {
    "name": "vettore-di-record",
    "description": "Una tabella (un vettore di record) col valore iniziale per record e una costante comune con un record ripetuto: il campo di un record letto, scritto e letto dalla console, e il «per ogni» sui record, il cui elemento è una copia presa prima del corpo."
  },
  "records": [
    {
      "name": "alunno",
      "fields": [
        {
          "name": "nome",
          "type": "string",
          "max_length": 20
        },
        {
          "name": "classe",
          "type": "string",
          "max_length": 3
        },
        {
          "name": "voto",
          "type": "integer"
        }
      ]
    }
  ],
  "shared_constants": [
    {
      "name": "VUOTI",
      "type": "record",
      "record": "alunno",
      "size": 2,
      "constant": true,
      "initial": {
        "each": [
          "\"-\"",
          "\"0X\"",
          "0"
        ]
      }
    }
  ],
  "functions": [
    {
      "id": "f1",
      "kind": "main",
      "data": [
        {
          "name": "classe",
          "type": "record",
          "record": "alunno",
          "size": 3,
          "initial": [
            [
              "\"Anna\"",
              "\"3A\"",
              "7"
            ],
            [
              "\"Bruno\"",
              "\"3B\"",
              "5"
            ],
            [
              "\"Carla\"",
              "\"3A\"",
              "8"
            ]
          ]
        },
        {
          "name": "a",
          "type": "record",
          "record": "alunno"
        },
        {
          "name": "somma",
          "type": "integer",
          "initial": "0"
        }
      ],
      "body": [
        {
          "id": "b2",
          "kind": "assignment",
          "target": "classe[1].voto",
          "value": "classe[1].voto + 1"
        },
        {
          "id": "b3",
          "kind": "read",
          "target": "classe[2].nome"
        },
        {
          "id": "b4",
          "kind": "for_each",
          "item": "a",
          "source": "classe",
          "body": [
            {
              "id": "b5",
              "kind": "assignment",
              "target": "classe[0].voto",
              "value": "0"
            },
            {
              "id": "b6",
              "kind": "write",
              "values": [
                "a.nome",
                "\" \"",
                "a.voto"
              ],
              "newline": true
            },
            {
              "id": "b7",
              "kind": "assignment",
              "target": "somma",
              "value": "somma + a.voto"
            }
          ]
        },
        {
          "id": "b8",
          "kind": "write",
          "values": [
            "VUOTI[1].classe",
            "\" \"",
            "somma",
            "\" \"",
            "classe[0].voto"
          ],
          "newline": true
        }
      ],
      "end": {
        "id": "b1"
      }
    }
  ],
  "test_cases": [
    {
      "name": "vettore-di-record",
      "inputs": [
        {
          "data": "classe",
          "text": "Dario"
        }
      ],
      "expected": {
        "output": "Anna 7\nBruno 6\nDario 8\n0X 21 0\n"
      }
    }
  ]
}
