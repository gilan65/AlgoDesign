{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AlgoDesign",
  "version": "../package.json",
  "identifier": "io.github.gilan65.algodesign",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4351",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "publisher": "AlgoDesign",
    "copyright": "© 2026 Giuseppe Lancellotti",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
