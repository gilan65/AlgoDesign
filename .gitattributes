# Fine riga: LF nel repository e su disco, su ogni sistema.
* text=auto eol=lf

# Gli script di Windows restano con CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# I progetti di AlgoDesign sono testo JSON in UTF-8.
*.algo text eol=lf

# I file di Flowgorithm sono testo XML in UTF-8. Il caso del corpus coi fine riga di Windows resta com'è: senza
# conversione, o git lo porterebbe a LF e la prova non vedrebbe più il CRLF.
*.fprg text eol=lf
/app/casi-flowgorithm/f-crlf.fprg -text

# Il lato di una prova che gira sotto Node, senza compilazione.
*.cjs text eol=lf

# Le chiavi che Tauri fonde nell'Info.plist dell'app per il Mac: testo XML.
*.plist text eol=lf

# Le figure delle guide disegnate come SVG: testo.
*.svg text eol=lf

# File binari: quelli di oggi e quelli che una release o una guida con le figure possono portare.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.dmg binary
*.AppImage binary
*.exe binary
*.dll binary
